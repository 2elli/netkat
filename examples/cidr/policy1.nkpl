internal_net_src = netsrc(192.168.1.0/24)
internal_net_dst = netdst(192.168.1.0/24)

host_src = netsrc(192.168.1.230)
host_dst = netdst(192.168.1.230)

malicious_src = netsrc(192.168.1.231)
malicious_dst = netdst(192.168.1.231)

outside_src = netsrc(1.1.1.1)
outside_dst = netdst(1.1.1.1)

remote_dst = netdst(210.51.188.116)
remote_src = netsrc(210.51.188.116)

inbound = @dir=0
outbound = @dir=1
tcp = @proto=6
ssh = @port=22
http = @port=80
https = @port=443

trusted_inbound = host_src + remote_src
banned = malicious_dst + malicious_src
redirect_ssh = ((inbound & @port=22) . @port <- 50) + ((outbound & @port=50) . @port <- 22)
anti_spoof = (inbound & (trusted_inbound + ~internal_net_src)) + (outbound & internal_net_src)

firewall = anti_spoof . ~banned . tcp . (redirect_ssh + (https + http + @port=9000 + @port=31337))

-- Check that a spoofed ip can't ge through
check (inbound . tcp . ~(ssh + http + https + @port=9000 + @port=31337) . ~trusted_inbound) . firewall == drop
check (inbound . host_src . ssh) . firewall !== drop
check (inbound . outside_src . https) . firewall !== drop
check (inbound . malicious_src . ssh) . firewall == drop
check (outbound . internal_net_src . internal_net_dst) . firewall !== drop
check (outbound . internal_net_dst . outside_src) . firewall == drop
check (outbound . internal_net_src . remote_dst . @port=50) . firewall !== drop
